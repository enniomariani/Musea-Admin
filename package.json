{
  "name": "musea-admin",
  "author": "Ennio Mariani",
  "email": "mail@enniomariani.ch",
  "version": "1.0.4",
  "description": "App for organizing and managing media files within Musea media players",
  "type": "module",
  "main": "./build/main/main.js",
  "scripts": {
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js ./tests --maxWorkers=50%",
    "e2e": "cls && wdio run wdio.conf.js",
    "e2eOneFile": "cls && wdio --spec e2e/ContentScreenTwoMediaPlayers.e2e.ts",
    "dev": "cross-env NODE_ENV=development npm start",
    "start": "electron-forge start",
    "build": "vue-tsc -p ./src/renderer/tsconfig.json --noEmit && vite build && tsc -p ./src/main/tsconfig.json && tsc-alias -p ./src/main/tsconfig.json",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "publish": "electron-forge publish"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/ping": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@wdio/cli": "^10.0.2",
    "@wdio/electron-service": "^10.4.0",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-websocket-mock": "^2.5.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "jsonschema": "^1.5.0",
    "mp4box": "^2.4.1",
    "musea-client": "^1.1.1",
    "ping": "^1.0.0",
    "vue-i18n": "^11.4.14"
  }
}
